# KiCad temporary, backup, and per-user state files

# Backups
*.bak
*-bak
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups/

# Autosave / temp
_autosave-*
\#auto_saved_files#
*.tmp
*~

# Per-user project-local state (regenerated by KiCad)
*.kicad_prl

# Caches
fp-info-cache
.history/

# Generated fabrication / documentation outputs (produced by kicad-cli / CI,
# published as artifacts — not committed)
/production/
/gerbers/
/fab/
*.rpt
erc.rpt
drc.rpt

# Generated board STEP export (kicad-cli / KiBot output — regenerated, not
# committed). Scoped to the root board so it does NOT swallow the vendored
# component 3D models tracked under 3d/ (see 3d/README.md).
/TAPRX-888.step
/TAPRX-888.stp

# Python bytecode
__pycache__/
*.pyc
